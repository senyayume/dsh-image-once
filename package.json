{
  "name": "dsh-image-once",
  "version": "0.2.0",
  "description": "Inlines each image block only in the request where it first appears, then swaps it for the harness's own placeholder text on every later request. On by default for every provider; each provider can be switched off or limited to specific models from the plugin page.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "image",
    "ttft",
    "attachments"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senyayume/dsh-image-once.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "screenshots.json",
    "assets"
  ],
  "scripts": {
    "test": "node test/run.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
